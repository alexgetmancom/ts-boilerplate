# Runtime
NODE_ENV=development
APP_NAME=ts-boilerplate
TZ=Europe/Moscow

# polling | webhook | http-only
BOT_MODE=polling
TELEGRAM_BOT_TOKEN=
# Required in webhook mode only
TELEGRAM_WEBHOOK_SECRET=
PUBLIC_WEBHOOK_URL=

# Comma-separated Telegram user IDs. Required: nobody gets through unless listed.
ALLOWED_USERS=

# Storage
DATABASE_URL=./data/app.db

# HTTP
BIND_HOST=127.0.0.1
PORT=8080

# Background worker
WORKER_INTERVAL_SECONDS=3600
